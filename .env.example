# CR-10S Workbench — environment template
# Copy to `.env` and fill in real values. `.env` is gitignored.
#   cp .env.example .env

# --- Raspberry Pi / OctoPi SSH ---
PI_HOST=octopi.local          # mDNS name; works on the same LAN as the Pi
PI_IP=192.168.x.x             # current LAN IP (changes between networks)
PI_SSH_USER=pi
PI_SSH_PASS=raspberry         # OctoPi default; change this on the Pi for security

# --- OctoPrint web UI ---
OCTOPRINT_URL=http://octopi.local
OCTOPRINT_WEB_USER=admin
OCTOPRINT_WEB_PASS=changeme

# --- OctoPrint REST API ---
# Settings -> API, or ~/.octoprint/config.yaml (api.key) on the Pi
OCTOPRINT_API_KEY=your-api-key-here

# --- Printer ---
PRINTER_SERIAL_PORT=/tmp/printer   # Klipper virtual port (Klipper itself owns /dev/ttyUSB0)
PRINTER_BAUDRATE=250000
